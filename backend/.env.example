# Copy this file to .env and adjust as needed.
# The app runs with zero configuration using local/free defaults below.

# "local" (default, no key/network needed) or "openai" (better quality, needs key)
EMBEDDING_PROVIDER=local

# "openai" (default): uses gpt-4o-mini if OPENAI_API_KEY is set below,
#   otherwise automatically falls back to a no-LLM extractive answer.
# "extractive": force the no-LLM fallback even if a key is set.
GENERATION_PROVIDER=openai

OPENAI_API_KEY=

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-4o-mini

DATABASE_PATH=knowledge_inbox.db

# Comma-separated list of allowed frontend origins for CORS.
# Example: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
